{
	"name": "de_ventas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ventas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(canal = lower(trim(canal)),",
				"          fecha_pedido = trim(fecha_pedido),",
				"          promocion_id = iif(isNull(promocion_id), 'sin promocion',trim(promocion_id))) ~> derivedColumn1",
				"derivedColumn1 derive(fecha_pedido = iif(instr(fecha_pedido,'/')>0,toDate(fecha_pedido,'dd/MM/yyyy'),toDate(fecha_pedido,'yyyy-MM-dd')),",
				"          total_pedido = toDecimal(total_pedido)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          venta_id as string,",
				"          fecha_venta as date,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          medio_pago as string,",
				"          promocion_id as string,",
				"          estado_venta as string,",
				"          total_venta as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          venta_id = pedido_id,",
				"          fecha_venta = fecha_pedido,",
				"          cliente_id,",
				"          sucursal_id,",
				"          canal,",
				"          medio_pago = subtotal,",
				"          promocion_id,",
				"          estado_venta = estado_pedido,",
				"          total_venta = total_pedido",
				"     )) ~> sink1"
			]
		}
	}
}